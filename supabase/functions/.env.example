# Copy to supabase/functions/.env for local dev:
#   supabase functions serve quest-result --env-file ./supabase/functions/.env
# For production, set them as project secrets instead:
#   supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash-lite (cheapest/fastest tier)
GEMINI_MODEL=gemini-3.5-flash-lite
